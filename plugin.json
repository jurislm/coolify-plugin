{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "coolify-plugin",
  "version": "3.7.1",
  "description": "Portable Coolify MCP plugin with local stdio tools generated from the official OpenAPI contract.",
  "author": {
    "name": "JurisLM"
  },
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Coolify",
        "composerIcon": "./assets/coolify.png",
        "logo": "./assets/coolify.png",
        "shortDescription": "Local Coolify API tools",
        "longDescription": "Generated local stdio tools for a configured Coolify instance.",
        "developerName": "JurisLM",
        "category": "Developer Tools",
        "capabilities": [
          "MCP",
          "Local"
        ],
        "defaultPrompt": [
          "List my Coolify resources."
        ]
      }
    }
  }
}
