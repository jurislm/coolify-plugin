{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "coolify-plugin",
  "version": "3.7.4",
  "description": "Portable Coolify MCP plugin with local stdio tools generated from the official OpenAPI contract.",
  "author": {
    "name": "JurisLM",
    "url": "https://github.com/jurislm"
  },
  "homepage": "https://github.com/jurislm/coolify-plugin",
  "repository": "https://github.com/jurislm/coolify-plugin",
  "license": "MIT",
  "keywords": [
    "coolify",
    "devops",
    "deployment",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Coolify",
        "shortDescription": "Manage Coolify through agent tools.",
        "longDescription": "Inspect and control Coolify applications, servers, databases, services, deployments, and environment configuration.",
        "developerName": "JurisLM",
        "category": "Developer tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "List my Coolify resources."
        ],
        "composerIcon": "./assets/coolify.png",
        "logo": "./assets/coolify.png",
        "websiteURL": "https://github.com/jurislm/coolify-plugin"
      }
    }
  }
}
