{
  "name": "@jurislm/coolify-plugin",
  "version": "4.0.18",
  "description": "Portable local stdio MCP plugin for Coolify",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "coolify-plugin": "dist/index.js"
  },
  "files": [
    "dist",
    "api",
    "openapi",
    "assets",
    "README.md",
    "LICENSE",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".mcp.json.example",
    ".app.json.example",
    ".codex-plugin",
    "skills"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --path-ignore-patterns dist",
    "api:fetch": "bun scripts/update-openapi.ts",
    "api:generate": "bun scripts/generate-openapi.ts",
    "api:check": "bun scripts/check-openapi.ts && bun run api:generate && git diff --exit-code -- api/manifest.json openapi src/generated",
    "manifest:check": "bun scripts/validate-plugin-manifests.ts",
    "package:check": "bun pm pack --dry-run 2>&1 | bun scripts/package-contents-check.ts",
    "release:test": "bun scripts/ci/test-release-pr-auto-merge.ts && bun scripts/ci/test-release-workflows.ts",
    "check": "bun run manifest:check && bun run api:check && bun run typecheck && bun run typecheck:tests && bun run build && bun test && bun run release:test && bun pm pack --dry-run 2>&1 | bun scripts/package-contents-check.ts",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "json-schema-to-zod": "2.8.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.3.14"
}
