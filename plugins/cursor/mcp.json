{
  "mcpServers": {
    "coolify": {
      "command": "bunx",
      "args": [
        "-y",
        "@jurislm/coolify-plugin@latest"
      ],
      "env": {
        "CURSOR_COOLIFY_BASE_URL": "${CURSOR_COOLIFY_BASE_URL}",
        "CURSOR_COOLIFY_ACCESS_TOKEN": "${CURSOR_COOLIFY_ACCESS_TOKEN}"
      }
    }
  }
}
